# ---- 核心 ----
DATABASE_URL=            # 留空则使用内置的 PGlite（WASM Postgres）本地文件库，便于零依赖开发
APP_MASTER_KEY=          # 32 字节 base64，用于加密 AI Provider 的 API Key
AUTH_SECRET=             # Auth.js JWT 会话签名密钥
APP_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# ---- 对象存储（腾讯云 COS）----
# 全部留空时，应用回退到「本地磁盘存储驱动」（仅用于开发/单机自托管）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_CDN_DOMAIN=

# ---- 可选：默认存储驱动：cos | local ----
STORAGE_DRIVER=local

# ---- 可选：任务 worker 模式 ----
# inprocess（默认）：进程内 setInterval 轮询，适合自托管 / 本地开发
# external：不启动进程内轮询，由外部 cron / 平台定时触发器打 POST /api/jobs/tick
#           适合 EdgeOne Pages 等实例会冻结的无服务器平台
JOB_WORKER_MODE=inprocess
# external 模式下 tick 端点的触发凭证（长随机串）；不配置则 /api/jobs/tick 拒绝所有请求
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JOB_TICK_SECRET=
